AI_GATEWAY__X402__ENABLED=false
AI_GATEWAY__X402__PAYMENT_GRPC_ENDPOINT=http://127.0.0.1:9091
AI_GATEWAY__X402__LOG_STREAM_KEY=lc:stream:x402_payment:log
AI_GATEWAY__X402__REQUEST_BODY_LOG_MAX_BYTES=0
AI_GATEWAY__X402__REQUEST_BODY_POLICY_MAX_BYTES=1048576
AI_GATEWAY__X402__PAYMENT_TIMEOUT=5s

PAYMENT_SERVICE_KEY=sk-payment-service-...
